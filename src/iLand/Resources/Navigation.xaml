    <StreamGeometry x:Key="IconTimer">M19.5 13.5 A7.5 7.5 0 1 1 4.5 13.5 A7.5 7.5 0 1 1 19.5 13.5 Z M10 3 H14 M12 13.5 V9.5 M17.8 6.2 L19.2 4.8</StreamGeometry>
    <StreamGeometry x:Key="IconTodo">M4 6.2 L5.7 7.9 L8.3 4.5 M11.5 6 H20 M4 12.2 L5.7 13.9 L8.3 10.5 M11.5 12 H20 M8.1 18 A1.9 1.9 0 1 1 4.3 18 A1.9 1.9 0 1 1 8.1 18 Z M11.5 18 H20</StreamGeometry>
    <StreamGeometry x:Key="IconShelf">M3.5 13 L6.5 5.5 H17.5 L20.5 13 V18.5 H3.5 Z M3.5 13 H8.5 L9.5 15.5 H14.5 L15.5 13 H20.5</StreamGeometry>
    <StreamGeometry x:Key="IconCapture">M3.5 8 H7.5 L9 5.5 H15 L16.5 8 H20.5 V18.5 H3.5 Z M15.4 13 A3.4 3.4 0 1 1 8.6 13 A3.4 3.4 0 1 1 15.4 13 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClipboard">M9.5 3.5 H14.5 A1 1 0 0 1 15.5 4.5 V5.5 A1 1 0 0 1 14.5 6.5 H9.5 A1 1 0 0 1 8.5 5.5 V4.5 A1 1 0 0 1 9.5 3.5 Z M8.5 5 H7 A1.5 1.5 0 0 0 5.5 6.5 V19 A1.5 1.5 0 0 0 7 20.5 H17 A1.5 1.5 0 0 0 18.5 19 V6.5 A1.5 1.5 0 0 0 17 5 H15.5</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M10.1 5.7 L10.4 3.1 L13.6 3.1 L13.9 5.7 L15.1 6.2 L17.2 4.6 L19.4 6.8 L17.8 8.9 L18.3 10.1 L20.9 10.4 L20.9 13.6 L18.3 13.9 L17.8 15.1 L19.4 17.2 L17.2 19.4 L15.1 17.8 L13.9 18.3 L13.6 20.9 L10.4 20.9 L10.1 18.3 L8.9 17.8 L6.8 19.4 L4.6 17.2 L6.2 15.1 L5.7 13.9 L3.1 13.6 L3.1 10.4 L5.7 10.1 L6.2 8.9 L4.6 6.8 L6.8 4.6 L8.9 6.2 Z M14.8 12 A2.8 2.8 0 1 1 9.2 12 A2.8 2.8 0 1 1 14.8 12 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12 5 V19 M5 12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconMinus">M5 12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconReset">M3.5 12 A8.5 8.5 0 1 0 6 6 L3.5 8.5 M3.5 3.5 V8.5 H8.5</StreamGeometry>
    <StreamGeometry x:Key="IconLyrics">M5.5 4.5 H18.5 A1.5 1.5 0 0 1 20 6 V14.5 A1.5 1.5 0 0 1 18.5 16 H11.5 L7.5 19.5 V16 H5.5 A1.5 1.5 0 0 1 4 14.5 V6 A1.5 1.5 0 0 1 5.5 4.5 Z M8 8.5 H16 M8 11.5 H13</StreamGeometry>
    <!-- Ikon kontrol media: segitiga dan batang diisi (Fill) lalu diberi garis tipis berujung bulat agar sudutnya lembut. -->
    <StreamGeometry x:Key="IconPlay">M8 5.5 L19 12 L8 18.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M7.5 5.5 H10.5 V18.5 H7.5 Z M13.5 5.5 H16.5 V18.5 H13.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPrevious">M6.5 5.5 V18.5 M18.5 5.8 L9 12 L18.5 18.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconNext">M17.5 5.5 V18.5 M5.5 5.8 L15 12 L5.5 18.2 Z</StreamGeometry>

    <!--
        Item tab bar di header island: satu tombol berisi satu ikon (ikon dikirim lewat Tag).
        Bentuk putih tab aktif BUKAN bagian item ini: ia satu elemen terpisah (TabIndicator di IslandWindow.xaml)
        yang digeser oleh code-behind, jadi item hanya mengurus ikonnya.

        Ikon punya dua lapis: Icon (putih) untuk tab tidak aktif dan IconActive (hitam) untuk tab aktif.
        Saat IsChecked berubah, keduanya crossfade. Aturan penting agar hover tidak mati:
        animasi crossfade memakai FillBehavior="Stop" dan nilai akhirnya dipegang oleh Setter trigger,
        sehingga tidak ada animasi yang "menempel" menimpa trigger hover.
        Tidak aktif: ikon 60% putih, hover naik ke 85% (lewat Opacity).
    -->
    <Style x:Key="TabBarItemStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="{x:Static helpers:TabLayout.TabBarItemWidth}" />
        <Setter Property="Height" Value="{x:Static helpers:TabLayout.TabBarItemHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="13" Background="Transparent">
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="0.6" />
                                <Path x:Name="IconActive" Data="{TemplateBinding Tag}"
                                      Stroke="{DynamicResource IslandBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="0" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <!-- IsChecked ditaruh paling akhir supaya menang atas hover -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Icon" Property="Opacity" Value="0" />
                            <Setter TargetName="IconActive" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity"
                                                         From="0.85" To="0" Duration="{x:Static helpers:MotionTokens.IconCrossfadeDuration}"
                                                         FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="IconActive" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="{x:Static helpers:MotionTokens.IconCrossfadeDuration}"
                                                         FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="0.6" Duration="{x:Static helpers:MotionTokens.IconCrossfadeDuration}"
                                                         FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="IconActive" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0" Duration="{x:Static helpers:MotionTokens.IconCrossfadeDuration}"
                                                         FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tombol bulat 32 px di header island (Settings). Ikon dikirim lewat Tag.
        Latar CardBrush, hover HoverBrush.
    -->
    <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="16" Background="{DynamicResource CardBrush}">
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="0.7" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Icon" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LyricsToggleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="16" Background="{DynamicResource CardBrush}">
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon" Data="{TemplateBinding Tag}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="0.7" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            <Setter TargetName="Icon" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Lyrics.IsOpen}" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Icon" Property="Opacity" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Kontrol media (tab Music) ===== -->

    <!-- Ikon tombol media: warna Fill dan Stroke mengikuti Foreground tombol induk. -->
    <Style x:Key="MediaIconStyle" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <!-- Ikon tombol utama: play saat berhenti, pause saat lagu diputar (mengikuti IsMediaPlaying di ViewModel). -->
    <Style x:Key="MediaPlayPauseIconStyle" TargetType="Path" BasedOn="{StaticResource MediaIconStyle}">
        <Setter Property="Data" Value="{StaticResource IconPlay}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                <Setter Property="Data" Value="{StaticResource IconPause}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Sebelumnya / berikutnya: lingkaran 30 px tanpa latar, hover HoverBrush, mati = 35% terlihat. -->
    <Style x:Key="MediaSkipButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="15" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Play / pause: lingkaran putih 38 px dengan ikon hitam. Hover = sedikit redup (Opacity). -->
    <Style x:Key="MediaPlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource IslandBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="19" Background="{DynamicResource TextPrimaryBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
