<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:iLand.Helpers"
                    xmlns:sc="clr-namespace:iLand.Views.SettingsControls"
                    xmlns:conv="clr-namespace:iLand.Converters">

    <!--
        Gaya dan kontrol bersama untuk jendela Settings baru (Prompt 6).
        Dimuat HANYA oleh SettingsWindow (di Window.Resources), bukan di App.xaml, jadi tidak membebani memori
        saat jendela Settings tertutup. Tidak ada animasi berulang dan tidak ada efek blur atau bayangan.

        Brush dari Theme.xaml dan Navigation.xaml diambil lewat DynamicResource (kamus ini dimuat terpisah).
        Semua nama di sini berawalan "Settings" dan TIDAK memakai nama yang sama dengan Controls.xaml (gaya Settings lama),
        supaya keduanya bisa hidup berdampingan sampai jendela lama digantikan.
        Warna yang dipakai di dalam animasi (toggle) ditulis sebagai Color di kamus ini, karena animasi tidak bisa memakai DynamicResource.
        Teks sekunder memakai TextSecondaryBrush (putih 60%) mengikuti keputusan proyek, bukan abu-abu opak #8E8E93.
    -->

    <!-- ===== Warna ===== -->
    <SolidColorBrush x:Key="SettingsWindowBrush" Color="#0F0F10" />
    <SolidColorBrush x:Key="SettingsDividerBrush" Color="#1AFFFFFF" />
    <Color x:Key="SettingsToggleOffColor">#39393D</Color>
    <Color x:Key="SettingsToggleOnColor">#30D158</Color>

    <!-- ===== Cincin fokus keyboard (hanya muncul saat Tab atau panah, bukan saat klik mouse) ===== -->
    <Style x:Key="SettingsFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" StrokeThickness="2"
                               Stroke="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sama, untuk kontrol berbentuk pil (toggle, tombol, item menu): sudut dibulatkan penuh.
         Memakai Border dengan CornerRadius besar (WPF memperkecilnya secara seragam menjadi setengah tinggi, jadi hasilnya pil).
         Rectangle dengan RadiusX dan RadiusY 100 menjadi ELIPS pada kontrol yang lebar. -->
    <Style x:Key="SettingsPillFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="100" BorderThickness="2"
                            BorderBrush="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Teks ===== -->
    <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SettingsPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Judul bagian kecil di atas kartu -->
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="4,22,0,8" />
    </Style>

    <Style x:Key="SettingsRowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Angka di kanan slider (misalnya 100%) -->
    <Style x:Key="SettingsValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Kartu dan pemisah ===== -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CompactCardRadius}" />
    </Style>

    <!-- Garis sangat tipis antar baris di dalam kartu, menjorok 16 px dari kiri -->
    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource SettingsDividerBrush}" />
    </Style>

    <!--
        Baris pengaturan: judul (13 SemiBold) dan deskripsi (12 redup) di kiri, kontrol (Content) di kanan, tinggi minimal 52.
        IsStacked = True: kontrol pindah ke bawah teks dan melebar penuh (untuk slider).
        Judul otomatis menjadi AutomationProperties.Name kontrol di dalamnya jika kontrol itu belum punya nama.
    -->
    <Style TargetType="{x:Type sc:SettingsRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type sc:SettingsRow}">
                    <Border MinHeight="52" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource SettingsRowTitle}" />
                            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}"
                                       Style="{StaticResource SettingsRowDescription}" />
                        </StackPanel>

                        <ContentPresenter x:Name="Presenter" Grid.Row="0" Grid.Column="1"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsStacked" Value="True">
                            <Setter TargetName="Presenter" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Presenter" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Presenter" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Presenter" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="Presenter" Property="Margin" Value="0,10,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== Toggle switch ala iOS (dipakai pada CheckBox) =====
        Perpindahan antar keadaan memakai VisualStateManager: keadaan awal saat jendela dibuka dipasang langsung
        (tanpa gerak), dan hanya perubahan oleh pengguna yang dianimasikan selama MotionTokens.SettingsToggleMs.
        Fokus keyboard terlihat lewat FocusVisualStyle. Tidak ada bayangan.
    -->
    <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsPillFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="26" Background="Transparent" SnapsToDevicePixels="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static helpers:MotionTokens.SettingsToggleDuration}"
                                                      GeneratedEasingFunction="{x:Static helpers:MotionTokens.ResizeEase}" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0" />
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource SettingsToggleOffColor}" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="18" Duration="0" />
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource SettingsToggleOnColor}" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Track" CornerRadius="13" Background="#39393D" />
                        <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11" Background="White"
                                HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tombol: sekunder (pil abu-abu) dan utama (aksen) ===== -->
    <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsPillFocusVisualStyle}" />
        <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" MinHeight="32" CornerRadius="16" Padding="16,0"
                            Background="{DynamicResource HoverBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#48484A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" MinHeight="32" CornerRadius="16" Padding="16,0"
                            Background="{DynamicResource AccentBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3D9BFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0A6FDD" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider berangka: bagian kecil ===== -->
    <Style x:Key="SettingsSliderTransparentButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bagian di kiri bulatan: garis aksen -->
    <Style x:Key="SettingsSliderFillButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bulatan 18 px. Saat slider difokus keyboard, bulatan diberi cincin aksen. -->
    <Style x:Key="SettingsSliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="White"
                            BorderBrush="Transparent" BorderThickness="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Background" Value="#E6E6EA" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                            <Setter TargetName="Knob" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider tipis. Panah keyboard, Home, dan End bekerja bawaan. -->
    <Style x:Key="SettingsSliderBarStyle" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" CornerRadius="2" Background="#3A3A3E" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SettingsSliderFillButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SettingsSliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SettingsSliderTransparentButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Slider berangka (kontrol SettingsSlider): slider di kiri, angka di kanan (misalnya "100%").
        Pakai: <sc:SettingsSlider Minimum="80" Maximum="115" TickFrequency="1" ValueFormat="{}{0:0}%" Value="{Binding ...}" />
        Bila nilainya pecahan (0,8 sampai 1,15), isi DisplayScale="100".
    -->
    <Style TargetType="{x:Type sc:SettingsSlider}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type sc:SettingsSlider}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Style="{StaticResource SettingsSliderBarStyle}"
                                Minimum="{TemplateBinding Minimum}"
                                Maximum="{TemplateBinding Maximum}"
                                TickFrequency="{TemplateBinding TickFrequency}"
                                IsSnapToTickEnabled="True"
                                AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SettingsValueText}"
                                   Text="{TemplateBinding DisplayText}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dropdown (ComboBox) gelap, termasuk daftar yang terbuka ===== -->
    <Style x:Key="SettingsDropdownItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2F2F33" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsDropdownStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsDropdownItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource HoverBrush}">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="12,7,32,7" IsHitTestVisible="False"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <!-- Cincin fokus keyboard -->
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="2" Margin="-2"
                                BorderBrush="{DynamicResource AccentBrush}" IsHitTestVisible="False" Visibility="Collapsed" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="10" Padding="4"
                                    Background="#222225" BorderBrush="{DynamicResource SettingsDividerBrush}"
                                    BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Konverter nama ikon (teks) menjadi Geometry, dipakai menu samping ===== -->
    <conv:ResourceKeyConverter x:Key="SettingsResourceKeyConverter" />

    <!-- ===== Toggle ikon untuk "Tabs on island": CheckBox berbentuk kotak bulat berisi satu ikon =====
         Tag = nama resource ikon (misalnya IconMusic). Menyala: ikon dan tinta biru aksen. Mati: ikon abu redup. -->
    <Style x:Key="SettingsTabToggleStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" CornerRadius="12" Background="{DynamicResource FillSubtleBrush}" SnapsToDevicePixels="True">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SettingsResourceKeyConverter}}"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource FillStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Tinta aksen sekitar 15%: #0A84FF dengan alpha 26 -->
                            <Setter TargetName="Box" Property="Background" Value="#260A84FF" />
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar tipis (vertikal) dan ScrollViewer untuk isi halaman ===== -->
    <Style x:Key="SettingsThinScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="10" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SettingsSliderTransparentButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Margin="2,0" CornerRadius="3" Background="#48484C" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="#6A6A70" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SettingsSliderTransparentButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsPageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                   Style="{StaticResource SettingsThinScrollBarStyle}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Kerangka halaman: judul, subjudul, lalu isi, dalam area yang bisa digulir. Lebar maksimal 640 dan terpusat.
        Halaman memakai kerangka ini lewat <sc:SettingsPageLayout Title="..." Subtitle="...">.
    -->
    <Style TargetType="{x:Type sc:SettingsPageLayout}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type sc:SettingsPageLayout}">
                    <ScrollViewer Style="{StaticResource SettingsPageScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="640" Margin="32,30,32,32" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource SettingsPageTitle}" />
                                <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}"
                                           Style="{StaticResource SettingsPageSubtitle}" />
                                <ContentPresenter Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menu samping (ListBox): item 36 px + jarak 2 px = 38 px per item (SettingsWindow.xaml.cs memakai angka yang sama) ===== -->
    <Style x:Key="SettingsNavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item aktif: teks dan ikon hitam di atas pil putih (pil putihnya indikator yang meluncur di belakang daftar). -->
    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsPillFocusVisualStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="18" Padding="14,0" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding IconKey, Converter={StaticResource SettingsResourceKeyConverter}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource IslandBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
