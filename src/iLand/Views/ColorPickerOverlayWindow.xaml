<Window x:Class="iLand.Views.ColorPickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLand Color picker"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="800" Height="600"
        KeyDown="Window_KeyDown">

    <!--
        Lapisan dari bawah ke atas:
        1. FrozenImage: gambar layar yang dibekukan (warna dibaca dari gambar ini, jadi pasti sama dengan yang terlihat)
        2. PickCanvas : menerima mouse, berisi kaca pembesar dan label warna
        3. Petunjuk di atas
    -->
    <Grid>
        <Image x:Name="FrozenImage" Stretch="Fill" />

        <Canvas x:Name="PickCanvas" Background="Transparent"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseRightButtonDown="Canvas_MouseRightButtonDown">

            <!-- Kaca pembesar: lingkaran 128 px berisi 16 x 16 piksel layar (setiap piksel 8 x 8). -->
            <Grid x:Name="Loupe" Width="128" Height="148" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse x:Name="LoupeImage" Width="128" Height="128" VerticalAlignment="Top"
                         Stroke="White" StrokeThickness="3"
                         RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <!-- Kotak penanda piksel yang dipilih (di tengah) -->
                <Rectangle Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,60,0,0" Stroke="Black" StrokeThickness="1" />
                <Rectangle Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Center"
                           Margin="0,59,0,0" Stroke="White" StrokeThickness="1" />
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#E6000000"
                        CornerRadius="10" Padding="8,3">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Swatch" Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0"
                                BorderBrush="White" BorderThickness="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="HexText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#CC000000" CornerRadius="14" Padding="14,7" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="13" Text="Click to pick a color  &#183;  Esc to cancel" />
        </Border>
    </Grid>
</Window>
