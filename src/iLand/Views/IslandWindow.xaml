<Window x:Class="iLand.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:iLand.Views.Components"
        xmlns:conv="clr-namespace:iLand.Converters"
        xmlns:helpers="clr-namespace:iLand.Helpers"
        xmlns:models="clr-namespace:iLand.Models"
        Title="iLand"
        Width="720" Height="340"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
        <conv:EnumVisibilityConverter x:Key="EnumVisibility" />

        <!-- Kartu aksi cepat di tab Home: tinggi 44, latar CardBrush, hover HoverBrush. Isinya diberikan lewat Content. -->
        <Style x:Key="QuickActionCardStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="{StaticResource CompactCardRadius}"
                                Background="{StaticResource CardBrush}" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tombol stop di pil perekaman: lingkaran merah transparan dengan kotak merah di tengah -->
        <Style x:Key="StopRecordingButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="#33FF453A" />
                            <Rectangle Width="10" Height="10" RadiusX="2.5" RadiusY="2.5" Fill="#FF453A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#55FF453A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Window berukuran TETAP (720 x 340) dan transparan. Yang dianimasikan hanya
        bentuk di dalamnya.

        Ada tiga lapis:
        1. HoverZone   = area hover dan drag-drop. Ukurannya = IslandHost + bingkai tambahan (Padding) 12 px di kiri,
                         kanan, dan bawah, HANYA saat island expanded, supaya island tidak menutup saat mouse bergerak
                         cepat ke tepi. Padding diatur code-behind (ApplyState). Bingkai itu hampir tak terlihat tetapi
                         menerima mouse, jadi ia menahan klik ke aplikasi di belakangnya selama island terbuka.
        2. IslandHost  = area yang menerima klik pada island. Ukurannya = island + celah 6 px di atasnya.
                         Latarnya hampir tak terlihat (alpha 1 dari 255) agar mouse tetap terdeteksi.
        3. Island      = bentuk hitam yang terlihat. Celah atasnya (Margin top) berubah:
                         6 px pada mode normal/expanded/notifikasi dan 0 px pada mode mini.

        Island punya empat isi yang bergantian: CollapsedContent, ExpandedContent, NotificationContent, RecordingContent.
        Isi expanded terdiri dari header (tab bar pill, judul tab, tombol Settings) dan area tab (TabHost).
    -->
    <Grid>
        <Border x:Name="HoverZone"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#01000000"
                AllowDrop="True"
                PreviewDragEnter="Island_PreviewDragOver"
                PreviewDragOver="Island_PreviewDragOver"
                PreviewDragLeave="Island_PreviewDragLeave"
                PreviewDrop="Island_PreviewDrop"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave">
        <Border x:Name="IslandHost"
                Width="200" Height="40"
                Background="#01000000"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">  

            <Border x:Name="Island"
                    Margin="0,6,0,0"
                    CornerRadius="17"
                    Background="{StaticResource IslandBrush}"
                    ClipToBounds="True">
                <Grid>

                    <!-- Cahaya sampul album: gradien lembut di belakang semua isi, hanya di tab Music saat ada media.
                         Tidak menerima klik. Muncul dan hilang dengan fade (stop gradiennya diisi IslandViewModel). -->
                    <Border x:Name="AccentGlow" IsHitTestVisible="False"
                            Background="{Binding MediaGlowBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowMusicGlow}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- ===== Collapsed (idle). Tiga bentuk (lihat PillLayoutMode dan IslandViewModel.UpdatePill) =====
                         Idle: jam kiri, cincin baterai + persen kanan.
                         Media: cincin baterai kiri (atau sisa timer), sampul + visualizer kanan, tengah kosong.
                         MediaLyrics: sampul kiri, baris lirik tengah (pill melebar sepanjang baris), visualizer kanan. -->
                    <Grid x:Name="CollapsedContent" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Kiri: jam atau sisa timer, ATAU cincin baterai (mode media), ATAU sampul (mode lirik). -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CollapsedCenterText}"
                                       Style="{StaticResource TextBodyStrong}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding PillShowLeftText, Converter={StaticResource BoolToVisibility}}" />

                            <components:BatteryIndicator RingSize="18"
                                                         VerticalAlignment="Center"
                                                         Percent="{Binding BatteryPercent}"
                                                         IsCharging="{Binding IsBatteryCharging}"
                                                         Visibility="{Binding PillShowLeftBattery, Converter={StaticResource BoolToVisibility}}" />

                            <Border Width="22" Height="22" CornerRadius="6"
                                    Background="{StaticResource CardBrush}"
                                    Visibility="{Binding PillShowLyrics, Converter={StaticResource BoolToVisibility}}">
                                <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding MediaArtwork}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- Tengah: baris lirik. Lebar pill dihitung dari panjang baris ini, jadi tidak dipotong. -->
                        <TextBlock x:Name="PillLyricText" Grid.Column="1"
                                   Text="{Binding Lyrics.CurrentLineText}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="12,0"
                                   Visibility="{Binding PillShowLyrics, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="PillLyricShift" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- Kanan: persen baterai (idle), sampul (mode media), visualizer (mode media dan lirik). -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding PillShowRightBattery, Converter={StaticResource BoolToVisibility}}">
                                <components:BatteryIndicator RingSize="18"
                                                             VerticalAlignment="Center"
                                                             Percent="{Binding BatteryPercent}"
                                                             IsCharging="{Binding IsBatteryCharging}" />
                                <TextBlock Text="{Binding BatteryText}" Margin="6,0,0,0"
                                           Style="{StaticResource TextBodyStrong}" FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Sampul kanan hanya di mode media. Di mode lirik sampul sudah ada di kiri. -->
                            <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                                    Background="{StaticResource CardBrush}" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding PillShowCover}" Value="True" />
                                                    <Condition Binding="{Binding PillShowLyrics}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding MediaArtwork}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>

                            <components:AudioVisualizer Height="14" VerticalAlignment="Center"
                                BarCount="6" BarWidth="2" BarSpacing="2"
                                BarBrush="{Binding MediaAccentBrush}"
                                Level="{Binding AudioMeter.Level}"
                                IsStatic="{Binding AudioMeter.IsUnavailable}"
                                Visibility="{Binding PillShowVisualizer, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Notification: ikon, judul, pesan ===== -->
                    <Grid x:Name="NotificationContent" Margin="16,0" Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <!-- Ikon bulat biasa: disembunyikan jika notifikasi membawa gambar kecil -->
                            <Border Width="32" Height="32" CornerRadius="16" Background="#2A2A3A">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNotificationThumbnail}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding NotificationGlyph}"
                                           FontFamily="Segoe UI Symbol" FontSize="15"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Pratinjau screenshot 40 x 40 (sudah dipotong persegi dan dikecilkan oleh ThumbnailHelper) -->
                            <Border Width="40" Height="40" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{StaticResource FillStrongBrush}"
                                    Visibility="{Binding HasNotificationThumbnail, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding NotificationThumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NotificationTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NotificationMessage}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Recording: titik merah, teks, timer, tombol stop ===== -->
                    <Grid x:Name="RecordingContent" Margin="16,0,10,0" Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="#FF453A" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="Recording" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" />

                        <TextBlock Grid.Column="2" Text="{Binding RecordingTimeText}" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF453A"
                                   FontSize="13" FontWeight="SemiBold" />

                        <Button Grid.Column="3" Style="{StaticResource StopRecordingButton}"
                                Command="{Binding StopRecordingCommand}" />
                    </Grid>

                    <!-- ===== Expanded: header (tab bar pill, judul tab, tombol Settings) + area tab ===== -->
                    <Grid x:Name="ExpandedContent" Opacity="0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header: tinggi 36, margin kiri-kanan 16 dan atas 10 -->
                        <Grid Grid.Row="0" Height="36" Margin="16,10,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab bar pill: 7 ikon. Urutan item = urutan enum IslandTab. Scroll mouse di sini memindahkan tab. -->
                            <Border x:Name="TabBar" Grid.Column="0" CornerRadius="18" Padding="4"
                                    Background="{StaticResource TabBarBrush}"
                                    MouseWheel="TabBar_MouseWheel">
                                <!-- Indikator putih (di belakang) digeser ke item aktif oleh code-behind (MoveTabIndicator). -->
                                <Grid>
                                <Border x:Name="TabIndicator" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Width="{x:Static helpers:TabLayout.TabBarItemWidth}"
                                        Height="{x:Static helpers:TabLayout.TabBarItemHeight}"
                                        CornerRadius="13" IsHitTestVisible="False"
                                        Background="{StaticResource TextPrimaryBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="IslandNav" ToolTip="Home"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconHome}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Home}}" />
                                <RadioButton GroupName="IslandNav" ToolTip="Music"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconMusic}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Music}}" />
                                <RadioButton GroupName="IslandNav" ToolTip="Mixer"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconMixer}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Mixer}}" />
                                <RadioButton GroupName="IslandNav" ToolTip="Timer"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconTimer}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Timer}}" />
                                <RadioButton GroupName="IslandNav" ToolTip="Tasks"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconTodo}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Todo}}" />
                                <RadioButton GroupName="IslandNav" ToolTip="Shelf"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconShelf}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Shelf}}" />
                                <RadioButton GroupName="IslandNav" ToolTip="Capture"
                                             Style="{StaticResource TabBarItemStyle}" Tag="{StaticResource IconCapture}"
                                             IsChecked="{Binding SelectedTab, Mode=TwoWay, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:IslandTab.Capture}}" />
                                </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Judul tab yang sedang aktif. Dua lapis supaya bisa crossfade saat berganti:
                                 TabTitle = judul baru (terikat ke ViewModel), TabTitleOld = judul sebelumnya yang memudar (diisi code-behind). -->
                            <Grid Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TabTitleOld" Opacity="0" IsHitTestVisible="False"
                                           Style="{StaticResource TextBodyStrong}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="TabTitle"
                                           Text="{Binding SelectedTabTitle}"
                                           Style="{StaticResource TextBodyStrong}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>

                            <!-- Tombol Settings. Button adalah ButtonBase, jadi kliknya tidak dianggap klik pada island (tidak memicu collapse). -->
                            <Button Grid.Column="2" ToolTip="Settings"
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    Tag="{StaticResource IconSettings}"
                                    Command="{Binding OpenSettingsCommand}" />
                        </Grid>

                        <!-- Area tab: hanya satu panel yang terlihat. Visibility panel diatur oleh code-behind
                             (ChangeTab) supaya perpindahan tab bisa dianimasikan. Urutan panel harus sama dengan enum IslandTab:
                             Home, Music, Mixer, Timer, Todo, Shelf, Capture. Margin konten: kiri-kanan 20, bawah 18. -->
                        <Grid x:Name="TabHost" Grid.Row="1" Margin="20,10,20,18">

                            <!-- ===== Tab Home: sapaan, jam besar, tanggal, baterai (kiri) + dua kartu aksi cepat (kanan) ===== -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GreetingText}" Style="{StaticResource TextCaption}" />
                                    <TextBlock Text="{Binding CurrentTime}" Style="{StaticResource TextDisplay}" />
                                    <TextBlock Text="{Binding CurrentDate}" Style="{StaticResource TextBody}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Baris baterai kecil: cincin + "71% · Charging". Disembunyikan jika perangkat tanpa baterai. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                                        <components:BatteryIndicator RingSize="14" VerticalAlignment="Center"
                                                                     Percent="{Binding BatteryPercent}"
                                                                     IsCharging="{Binding IsBatteryCharging}" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextCaption}">
                                            <Run Text="{Binding BatteryText, Mode=OneWay}" />
                                            <Run Text=" &#x00B7; " />
                                            <Run Text="{Binding BatteryStatusText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Dua kartu aksi cepat -->
                                <StackPanel Grid.Column="1" Width="188" VerticalAlignment="Center">
                                    <Button Style="{StaticResource QuickActionCardStyle}"
                                            Command="{Binding Capture.CaptureAreaCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource FillStrongBrush}">
                                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource IconCapture}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Screenshot" Style="{StaticResource TextBodyStrong}" />
                                                <TextBlock Text="{Binding Capture.ShortcutText}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource QuickActionCardStyle}" Margin="0,8,0,0"
                                            Command="{Binding StartFocusCommand}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource FillStrongBrush}">
                                                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource IconTimer}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Focus" Style="{StaticResource TextBodyStrong}" />
                                                <TextBlock Text="{Binding FocusCardSubtitle}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- ===== Tab Music (isinya ada di Views/Components/MusicTabView.xaml) ===== -->
                            <components:MusicTabView />

                            <!-- ===== Tab Mixer: volume master dan per aplikasi ===== -->
                            <components:MixerView DataContext="{Binding Mixer}" />

                            <!-- ===== Tab Timer (isinya ada di Views/Components/TimerView.xaml) ===== -->
                            <components:TimerView />

                            <!-- ===== Tab Todo ===== -->
                            <components:TodoView DataContext="{Binding Todo}" />

                            <!-- ===== Tab Shelf ===== -->
                            <components:ShelfView DataContext="{Binding Shelf}" />

                            <!-- ===== Tab Capture ===== -->
                            <components:CaptureView DataContext="{Binding Capture}" />

                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
        </Border>
    </Grid>
</Window>
