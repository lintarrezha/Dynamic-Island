<Window x:Class="iLand.Views.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLand Capture"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="800" Height="600"
        KeyDown="Window_KeyDown">

    <!--
        Lapisan dari bawah ke atas:
        1. FrozenImage    : gambar layar yang dibekukan
        2. DimPath        : lapisan gelap di luar area terpilih
        3. SelectionCanvas: bingkai pilihan, label ukuran, dan petunjuk. Menerima semua event mouse.
    -->
    <Grid>
        <Image x:Name="FrozenImage" Stretch="Fill" />

        <Path x:Name="DimPath" Fill="#99000000" IsHitTestVisible="False" />

        <Canvas x:Name="SelectionCanvas" Background="Transparent"
                MouseLeftButtonDown="Root_MouseLeftButtonDown"
                MouseMove="Root_MouseMove"
                MouseLeftButtonUp="Root_MouseLeftButtonUp"
                MouseRightButtonDown="Root_MouseRightButtonDown">

            <Border x:Name="SelectionFrame" BorderBrush="White" BorderThickness="1.5"
                    Visibility="Collapsed" IsHitTestVisible="False" />

            <Border x:Name="SizeBadge" Background="#CC000000" CornerRadius="6" Padding="8,3"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#CC000000" CornerRadius="14" Padding="14,7" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13" />
        </Border>
    </Grid>
</Window>
