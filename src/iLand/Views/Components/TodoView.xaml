<UserControl x:Class="iLand.Views.Components.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:iLand.Views.Components"
             xmlns:helpers="clr-namespace:iLand.Helpers">

    <!--
        Tab Todo (tinggi total 74 + 72 + 36 per tugas, dibatasi 212 sampai 290 oleh TabLayout).
        Isi, dari atas: header (22) + jarak 4, daftar (sisa ruang, maksimal 4 baris terlihat, sisanya digulir),
        jarak 8, baris input (38). Satu baris tugas = 36 (34 isi + 2 jarak).
        Animasi: baris baru masuk (tinggi, fade, geser kecil), baris yang dihapus keluar (tinggi dan fade),
        centang digambar, garis coret tumbuh dari kiri. Durasi dari MotionTokens.
        Semua animasi memakai FillBehavior Stop atau nilai akhir yang diatur lebih dulu, kecuali baris keluar dan garis coret.
    -->
    <UserControl.Resources>

        <!-- Lingkaran centang 20 px. Belum selesai: lingkaran kosong. Selesai: terisi biru, tanda centang digambar. -->
        <Style x:Key="TaskCheckButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse Width="20" Height="20" Stroke="#80FFFFFF" StrokeThickness="1.5" />
                            <Ellipse x:Name="CheckFill" Width="20" Height="20"
                                     Fill="{StaticResource AccentBrush}" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="CheckFillScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="20" Height="20">
                                    <!-- Opacity 0 selama belum selesai: tanpa ini, ujung-ujung goresan tetap terlihat sebagai dua titik,
                                         karena ujung bulat dan tutup goresan digambar walau garisnya disembunyikan oleh pola putus-putus. -->
                                    <Path x:Name="Tick" Data="M5.5 10.5 L8.8 13.5 L14.5 7"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeDashCap="Round"
                                          StrokeDashArray="7 7" StrokeDashOffset="7" Opacity="0" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="CheckFill" Property="Opacity" Value="1" />
                                <Setter TargetName="Tick" Property="StrokeDashOffset" Value="0" />
                                <Setter TargetName="Tick" Property="Opacity" Value="1" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetName="CheckFill" Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.16" FillBehavior="Stop" />
                                            <DoubleAnimation Storyboard.TargetName="CheckFillScale" Storyboard.TargetProperty="ScaleX"
                                                             From="0.6" To="1" Duration="0:0:0.2" FillBehavior="Stop"
                                                             EasingFunction="{x:Static helpers:MotionTokens.ResizeEase}" />
                                            <DoubleAnimation Storyboard.TargetName="CheckFillScale" Storyboard.TargetProperty="ScaleY"
                                                             From="0.6" To="1" Duration="0:0:0.2" FillBehavior="Stop"
                                                             EasingFunction="{x:Static helpers:MotionTokens.ResizeEase}" />
                                            <!-- Goresan centang digambar dari awal (offset 7 ke 0). Tanpa BeginTime: sebelum animasi mulai,
                                                 nilai Setter (tergambar penuh) akan terlihat sekilas. -->
                                            <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="7" To="0" Duration="0:0:0.28" FillBehavior="Stop"
                                                             EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" />
                                            <!-- Centang baru terlihat setelah lingkaran mulai terisi (60 ms pertama tersembunyi). -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity"
                                                                           FillBehavior="Stop">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol hapus (tanda silang), baru terlihat saat baris disorot mouse. -->
        <Style x:Key="DeleteTaskButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Path x:Name="Cross" Data="M9.5 9.5 L16.5 16.5 M16.5 9.5 L9.5 16.5"
                                  Stroke="#80FFFFFF" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cross" Property="Stroke" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kotak input: pill CardBrush, garis aksen saat fokus. -->
        <Style x:Key="TaskInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#660A84FF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="14" Padding="14,0"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol tambah: bulat 38 px, isi aksen, ikon plus putih. Redup bila kotak input kosong. -->
        <Style x:Key="AddTaskButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTip" Value="Add task" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="19" Background="{StaticResource AccentBrush}">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NewTaskTitle}" Value="">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Satu baris tugas. RowRoot setinggi 36 (34 isi + 2 jarak) dengan LayoutTransform ScaleY untuk animasi tinggi. -->
        <DataTemplate x:Key="TaskRowTemplate">
            <Border x:Name="RowRoot" Height="36" Padding="0,0,0,2" Background="Transparent">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="RowScale" ScaleY="1" />
                </Border.LayoutTransform>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RowShift" Y="0" />
                </Border.RenderTransform>

                <Grid x:Name="Row" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource TaskCheckButtonStyle}"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleCommand}" />

                    <!-- Teks dan garis coret berbagi satu Grid yang selebar teks, jadi garis coret selebar teks. -->
                    <Grid Grid.Column="1" Margin="6,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Height="1.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Fill="{StaticResource TextTertiaryBrush}"
                                   RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="StrikeScale" ScaleX="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <Button x:Name="DeleteButton" Grid.Column="2" Style="{StaticResource DeleteTaskButton}"
                            VerticalAlignment="Center"
                            Command="{Binding DeleteCommand}" ToolTip="Delete" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- Hover: ikon hapus terlihat. -->
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeleteButton" Property="Opacity" Value="1" />
                </Trigger>

                <!-- Tugas selesai: garis coret tumbuh dari kiri. Dibatalkan: garis menghilang. -->
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StrikeScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.22"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StrikeScale" Storyboard.TargetProperty="ScaleX"
                                                 To="0" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>

                <!-- Baris baru: tinggi dan fade dari nol, geser kecil dari atas. Nilai akhir tidak ditahan (Stop). -->
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                 From="0" To="1" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 FillBehavior="Stop"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ResizeEase}" />
                                <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="RowShift" Storyboard.TargetProperty="Y"
                                                 From="-6" To="0" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 FillBehavior="Stop"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ResizeEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <!-- Baris keluar: kebalikannya. Setelah selesai, TodoViewModel membuang barisnya. -->
                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ResizeEase}" />
                                <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{x:Static helpers:MotionTokens.RowDuration}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: "TASKS" di kiri, di kanan "Clear done" (bila ada yang selesai) dan "2/5 done". -->
        <Grid Grid.Row="0" Height="22" Margin="0,0,0,4">
            <TextBlock Text="TASKS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource TextTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource ChipButtonStyle}" Content="Clear done" Margin="0,0,10,0"
                        Command="{Binding ClearCompletedCommand}"
                        Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding SummaryText}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Daftar tugas -->
        <Grid Grid.Row="1">
            <components:EmptyState Icon="{StaticResource IconTodo}" Text="No tasks yet"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TaskRowTemplate}" />
            </ScrollViewer>
        </Grid>

        <!-- Tambah tugas: ketik lalu tekan Enter atau tombol plus -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="NewTaskBox" Height="38" Style="{StaticResource TaskInputStyle}"
                         MaxLength="200"
                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Teks petunjuk: tampil hanya saat kotak kosong -->
                <TextBlock Text="Add a task..." Margin="15,0,0,0"
                           VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NewTaskBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource AddTaskButtonStyle}"
                    Command="{Binding AddTaskCommand}" />
        </Grid>
    </Grid>
</UserControl>
