<UserControl x:Class="iLand.Views.Components.ControlTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:iLand.Helpers"
             x:Name="Root">

    <!--
        Satu kartu di tab Control. Dua tata letak (properti Variant):
        Wide     : kartu persegi panjang lebar, ikon di kiri, judul dan keterangan bertumpuk di kanan (Wi-Fi, Bluetooth).
        IconOnly : kartu persegi kecil, hanya ikon di tengah (Dark mode, Mute, Night light, dst). Nama tombol ada di tooltip.
        Ukuran ditentukan oleh yang memasang (ControlView.xaml). Sudut membulat memakai satu token: ControlTileRadius (Theme.xaml).
        Tidak aktif = kaca abu-abu (ControlGlassBrush). Aktif = putih, ikon berwarna (properti ActiveBrush), teks gelap.
        Mati (IsEnabled false) = redup. Gaya bernama memakai RelativeSource (bukan ElementName) karena berada di Resources.
    -->
    <UserControl.Resources>
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Chrome">
                            <ContentPresenter />
                            <!-- Efek hover memakai Opacity (aturan animasi iLand) -->
                            <Border x:Name="HoverOverlay" CornerRadius="{StaticResource ControlTileRadius}" Background="#14FFFFFF"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileCardStyle" TargetType="Border">
            <!-- Radius tetap (bukan 100): kartu tetap persegi panjang dengan sudut membulat, bukan kapsul atau lingkaran -->
            <Setter Property="CornerRadius" Value="{StaticResource ControlTileRadius}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource ControlGlassBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlGlassBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlActiveFillBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ControlActiveBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Stroke" Value="{Binding ActiveBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStrong}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ControlActiveTitleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ControlActiveSubtitleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Menampilkan satu tata letak hanya jika Variant cocok -->
        <Style x:Key="WideOnlyStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Wide">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconOnlyStyle" TargetType="Viewbox">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="IconOnly">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Button Style="{StaticResource TileButtonStyle}"
            Command="{Binding Command, ElementName=Root}"
            ToolTip="{Binding Title, ElementName=Root}"
            AutomationProperties.Name="{Binding Title, ElementName=Root}">
        <Border Style="{StaticResource TileCardStyle}">
            <Grid>
                <!-- Wide: ikon kiri (24 px), judul dan keterangan bertumpuk -->
                <Grid Style="{StaticResource WideOnlyStyle}" Margin="20,0,14,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Icon, ElementName=Root}" Style="{StaticResource TileIconStyle}" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource TileTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource TileSubtitleStyle}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- IconOnly: hanya ikon 22 px di tengah -->
                <Viewbox Style="{StaticResource IconOnlyStyle}" Width="22" Height="22"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{Binding Icon, ElementName=Root}" Style="{StaticResource TileIconStyle}" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Button>
</UserControl>
