<UserControl x:Class="iLand.Views.Components.MusicGlassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:iLand.Views.Components"
             xmlns:helpers="clr-namespace:iLand.Helpers">

    <!--
        Tab Music gaya Glass. DataContext diwarisi dari IslandWindow (IslandViewModel). Tampil hanya saat ShowGlassMusicLayout.
        Susunan (isi tab 216 px tinggi): baris atas (sampul 56, judul dan artis, kontrol), kartu lirik kaca yang mengisi sisa
        tinggi, lalu baris progres dan volume. Panel lirik memakai LyricsPanel yang sama dengan gaya Classic (gulir halus,
        klik baris = loncat). Titik tiga di kartu membuka menu geser waktu lirik di dalam island (bukan Popup).
        Volume di sini adalah volume aplikasi pemutar, sama dengan gaya Classic. Latar blur sampul ada di IslandWindow.xaml
        (ExpandedContent), karena harus memenuhi seluruh island. Progres berwarna aksen sampul, volume putih.
        Tanpa Effect dan tanpa OpacityMask: keduanya membuat animasi island patah-patah.
    -->
    <UserControl.Resources>

        <!-- Sebelumnya / berikutnya: lingkaran 34 berlatar putih transparan. -->
        <Style x:Key="GlassSkipButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="17" Background="#24FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play / pause: lingkaran putih 44 dengan ikon hitam. -->
        <Style x:Key="GlassPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="22" Background="#FFFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol pil kecil di menu timing: latar putih transparan. -->
        <Style x:Key="GlassSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Padding="12,0" Background="#24FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol utama kartu "Lyrics are off": pil putih, teks hitam. -->
        <Style x:Key="GlassPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="15" Padding="16,0" Background="#FFFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titik tiga di sudut kartu lirik. Menyala saat menu terbuka. -->
        <Style x:Key="GlassDotsButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="#66000000">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="3" Height="3" Fill="#FFFFFFFF" />
                                <Ellipse Width="3" Height="3" Margin="3,0" Fill="#FFFFFFFF" />
                                <Ellipse Width="3" Height="3" Fill="#FFFFFFFF" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#80000000" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Lyrics.IsTimingMenuOpen}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#47FFFFFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ikon speaker: berganti ke ikon bisu saat volume aplikasi dibisukan. -->
        <Style x:Key="GlassVolumeIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconVolumeOn}" />
            <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AppVolume.IsMuted}" Value="True">
                    <Setter Property="Data" Value="{StaticResource IconVolumeOff}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding ShowGlassMusicLayout, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Baris atas: sampul 56, judul dan artis, kontrol di kanan ===== -->
        <Grid Grid.Row="0" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="56" Height="56">
                <Border CornerRadius="12" Background="{StaticResource CardBrush}">
                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconMusic}"
                                  Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding MediaArtwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding MediaTitle}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding MediaArtist, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MediaSourceApp, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GlassSkipButtonStyle}"
                        ToolTip="Previous" AutomationProperties.Name="Previous track"
                        IsEnabled="{Binding CanGoPrevious}"
                        Command="{Binding PreviousTrackCommand}">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource MediaIconStyle}" Data="{StaticResource IconPrevious}" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource GlassPlayButtonStyle}" Margin="8,0"
                        ToolTip="Play / Pause" AutomationProperties.Name="Play or pause"
                        IsEnabled="{Binding CanPlayPause}"
                        Command="{Binding TogglePlayPauseCommand}">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource MediaPlayPauseIconStyle}" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource GlassSkipButtonStyle}"
                        ToolTip="Next" AutomationProperties.Name="Next track"
                        IsEnabled="{Binding CanGoNext}"
                        Command="{Binding NextTrackCommand}">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource MediaIconStyle}" Data="{StaticResource IconNext}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Kartu lirik kaca ===== -->
        <Border Grid.Row="1" Margin="0,10" CornerRadius="18"
                Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
            <Grid>
                <!-- Lirik aktif: panel lirik, titik tiga, dan menu timing. Disembunyikan saat lirik dimatikan di Settings. -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowGlassLyricsOff}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <components:LyricsPanel Margin="18,0,52,0" DataContext="{Binding Lyrics}" />

                    <Button x:Name="TimingMenuButton" Style="{StaticResource GlassDotsButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                            ToolTip="Lyrics timing" AutomationProperties.Name="Lyrics timing"
                            Command="{Binding Lyrics.ToggleTimingMenuCommand}" />

                    <Border x:Name="TimingMenu" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,46,0" Width="232" Padding="12,10" CornerRadius="16"
                            Background="#F0121214" BorderBrush="#29FFFFFF" BorderThickness="1"
                            Visibility="{Binding Lyrics.IsTimingMenuOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Lyrics timing" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                <Button Content="Reset" Style="{StaticResource GlassSmallButtonStyle}" Height="24"
                                        HorizontalAlignment="Right" AutomationProperties.Name="Reset lyrics timing"
                                        Command="{Binding Lyrics.OffsetResetCommand}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="− Later" Style="{StaticResource GlassSmallButtonStyle}"
                                        ToolTip="Show lyrics later" AutomationProperties.Name="Lyrics later"
                                        Command="{Binding Lyrics.OffsetDownCommand}" />
                                <TextBlock Grid.Column="1" Text="{Binding Lyrics.OffsetText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold" />
                                <Button Grid.Column="2" Content="Earlier +" Style="{StaticResource GlassSmallButtonStyle}"
                                        ToolTip="Show lyrics earlier" AutomationProperties.Name="Lyrics earlier"
                                        Command="{Binding Lyrics.OffsetUpCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Lirik dimatikan di Settings: tombol ini sekaligus persetujuan. Tidak ada permintaan jaringan sebelum ditekan. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding ShowGlassLyricsOff, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Lyrics are off" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold" />
                    <Button Content="Turn on lyrics" Style="{StaticResource GlassPillButtonStyle}" Margin="0,8,0,0"
                            HorizontalAlignment="Center" AutomationProperties.Name="Turn on lyrics"
                            Command="{Binding Lyrics.ConfirmCommand}" />
                    <TextBlock Text="Song title, artist and album are sent to lrclib.net to find the lyrics. Nothing else is sent."
                               Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               Style="{StaticResource TextCaption}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Baris bawah: waktu, progres, sisa waktu, volume aplikasi ===== -->
        <Grid Grid.Row="2" Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding MediaElapsedText}" MinWidth="32"
                       Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
            <components:SeekBar Grid.Column="1" Margin="8,0" Height="14" VerticalAlignment="Center"
                                FillBrush="{Binding MediaAccentBrush}"
                                Value="{Binding MediaProgress, Mode=OneWay}"
                                IsSeekEnabled="{Binding CanSeek}"
                                SeekCommand="{Binding SeekCommand}" />
            <TextBlock Grid.Column="2" Text="{Binding MediaRemainingText}" MinWidth="36" TextAlignment="Right"
                       Style="{StaticResource TextCaption}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                        ToolTip="Volume of the playing app">
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource GlassVolumeIconStyle}" />
                    </Canvas>
                </Viewbox>
                <components:VolumeSlider Width="80" Height="18" Margin="8,0,0,0" VerticalAlignment="Center"
                                         FillBrush="{StaticResource TextPrimaryBrush}"
                                         AutomationProperties.Name="App volume"
                                         IsEnabled="{Binding AppVolume.IsAvailable}"
                                         Value="{Binding AppVolume.Volume, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
