<UserControl x:Class="iLand.Views.Components.SeekBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bar progres lagu: track 4 px, isi aksen biru, thumb bulat 12 px yang muncul saat hover atau digeser.
        Area klik setinggi kontrol (diatur pemakai, misalnya 16 px) supaya bar tipis tetap mudah diklik.
        Klik atau geser lalu lepas = SeekCommand dijalankan dengan parameter 0.0 sampai 1.0.
        Jika IsSeekEnabled false, bar hanya tampilan: tanpa thumb dan tanpa reaksi klik.
    -->
    <Grid x:Name="Root" Background="Transparent"
          SizeChanged="Root_SizeChanged"
          MouseEnter="Root_MouseChanged"
          MouseLeave="Root_MouseChanged"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          LostMouseCapture="Root_LostMouseCapture">

        <Border x:Name="TrackBar" Height="4" CornerRadius="2"
                Background="{StaticResource HoverBrush}" VerticalAlignment="Center" />

        <Border x:Name="FillBar" Height="4" Width="0" CornerRadius="2"
                Background="{Binding FillBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Ellipse x:Name="ThumbDot" Width="12" Height="12"
                 Fill="{StaticResource TextPrimaryBrush}"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Opacity="0" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ThumbShift" X="0" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
