<UserControl x:Class="iLand.Views.Components.MusicTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:iLand.Views.Components"
             xmlns:helpers="clr-namespace:iLand.Helpers">

    <!--
        Isi tab Music. DataContext diwarisi dari IslandWindow (IslandViewModel).
        Empat bagian, hanya sebagian yang terlihat pada satu waktu:
        1. EmptyState "No media playing" (tidak ada media).
        2. Layout biasa (ShowNormalMusicLayout): sampul besar di kiri; di kanan judul + visualizer, artis dan sumber,
           progress dan waktu, kontrol + volume aplikasi, lalu baris bawah (hanya tombol Lyrics).
        3. Layout lirik (ShowLyricsLayout): kolom kiri 232 px (sampul 56, judul, progress, kontrol, stepper + tombol Lyrics)
           dan panel lirik di kanan. Volume tidak ada di sini karena kolomnya sempit.
        4. Kartu konfirmasi "Turn on lyrics?" yang menutupi isi tab (ShowLyricsConfirm).
    -->
    <UserControl.Resources>

        <!-- Ikon volume (IconVolumeOn, IconVolumeOff) kini ada di Navigation.xaml agar dipakai bersama tab Mixer. -->

        <!-- Tombol utama kartu konfirmasi: isi aksen biru, teks putih. -->
        <Style x:Key="PrimaryChipButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="{StaticResource ControlRadius}" Padding="16,7"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sebelumnya / berikutnya: ikon polos tanpa latar, lingkaran halus saat hover. Mati = 35% terlihat. -->
        <Style x:Key="MusicTransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="17" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play / pause: ikon polos yang lebih besar, tanpa lingkaran putih. -->
        <Style x:Key="MusicPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource MusicTransportButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
        </Style>

        <!-- Tombol kecil bulat untuk stepper timing: tanda minus atau plus sebagai isi. -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol Lyrics: pil berisi ikon gelembung lirik. Mati = latar kartu dan ikon redup. Panel lirik terbuka = pil putih dengan ikon hitam. -->
        <Style x:Key="LyricsPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="{StaticResource CardBrush}">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Data="{StaticResource IconLyrics}"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Lyrics.IsOpen}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Icon" Property="Stroke" Value="#FF000000" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ikon speaker: berganti ke ikon bisu saat volume nol. -->
        <Style x:Key="VolumeIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource IconVolumeOn}" />
            <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AppVolume.IsMuted}" Value="True">
                    <Setter Property="Data" Value="{StaticResource IconVolumeOff}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>

        <components:EmptyState Icon="{StaticResource IconMusic}" Text="No media playing"
                               Visibility="{Binding ShowNoMediaMessage, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===== Layout biasa ===== -->
        <Grid Visibility="{Binding ShowNormalMusicLayout, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Kiri: sampul 144 x 144, radius 16. Tanpa sampul: kotak CardBrush + ikon nada. -->
            <Grid Grid.Column="0" Width="144" Height="144" VerticalAlignment="Center">
                <Border CornerRadius="16" Background="{StaticResource CardBrush}">
                    <Viewbox Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconMusic}"
                                  Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding MediaArtwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Kanan: judul + visualizer, artis dan sumber, progress, kontrol + volume, baris bawah. -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Judul (16 SemiBold) di kiri, visualizer di kanan -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MediaTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <components:AudioVisualizer Grid.Column="1" Margin="12,0,0,0" Height="16" VerticalAlignment="Center"
                        BarCount="16" BarWidth="2" BarSpacing="2.5"
                        BarBrush="{Binding MediaAccentBrush}"
                        Level="{Binding AudioMeter.Level}"
                        IsStatic="{Binding AudioMeter.IsUnavailable}" />
                </Grid>

                <!-- Artis, titik pemisah, ikon aplikasi pemutar, nama aplikasi -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding MediaArtist}" MaxWidth="150"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="·" Margin="6,0" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                    <Grid Width="13" Height="13" VerticalAlignment="Center">
                        <Image Source="{Binding MediaSourceIcon}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Pengganti: ikon nada kecil, tampil hanya jika ikon aplikasi tidak ada. -->
                        <Viewbox>
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MediaSourceIcon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconMusic}"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="{Binding MediaSourceApp}" Margin="5,0,0,0" MaxWidth="90"
                               Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Progress: bar (bisa diklik dan digeser jika pemutar mengizinkan), lalu waktu di bawahnya -->
                <components:SeekBar Grid.Row="3" Height="14" VerticalAlignment="Center"
                                    FillBrush="{Binding MediaAccentBrush}"
                                    Value="{Binding MediaProgress, Mode=OneWay}"
                                    IsSeekEnabled="{Binding CanSeek}"
                                    SeekCommand="{Binding SeekCommand}" />
                <Grid Grid.Row="4" Margin="0,1,0,0">
                    <TextBlock Text="{Binding MediaElapsedText}" Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MediaRemainingText}" Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Kontrol (kiri-tengah) dan volume aplikasi (kanan) -->
                <Grid Grid.Row="5" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource MusicTransportButtonStyle}"
                                ToolTip="Previous" AutomationProperties.Name="Previous track"
                                IsEnabled="{Binding CanGoPrevious}"
                                Command="{Binding PreviousTrackCommand}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MediaIconStyle}" Data="{StaticResource IconPrevious}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource MusicPlayButtonStyle}" Margin="6,0"
                                ToolTip="Play / Pause" AutomationProperties.Name="Play or pause"
                                IsEnabled="{Binding CanPlayPause}"
                                Command="{Binding TogglePlayPauseCommand}">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MediaPlayPauseIconStyle}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource MusicTransportButtonStyle}"
                                ToolTip="Next" AutomationProperties.Name="Next track"
                                IsEnabled="{Binding CanGoNext}"
                                Command="{Binding NextTrackCommand}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MediaIconStyle}" Data="{StaticResource IconNext}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Volume aplikasi pemutar: pil dengan ikon speaker dan slider. Mati jika sesi audio tidak ditemukan. -->
                    <Border Grid.Column="1" Height="30" CornerRadius="15" Padding="10,0"
                            Background="{StaticResource CardBrush}" VerticalAlignment="Center"
                            ToolTip="Volume of the playing app">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource VolumeIconStyle}" />
                                </Canvas>
                            </Viewbox>
                            <components:VolumeSlider Width="92" Height="18" Margin="8,0,0,0" VerticalAlignment="Center"
                                                     FillBrush="{Binding MediaAccentBrush}"
                                                     AutomationProperties.Name="App volume"
                                                     IsEnabled="{Binding AppVolume.IsAvailable}"
                                                     Value="{Binding AppVolume.Volume, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Baris bawah: hanya tombol Lyrics di kanan. Stepper timing baru muncul setelah panel lirik terbuka (layout lirik di bawah). -->
                <Grid Grid.Row="6" Margin="0,4,0,0">
                    <Button Style="{StaticResource LyricsPillButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Lyrics" AutomationProperties.Name="Lyrics"
                            Command="{Binding Lyrics.ToggleCommand}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Layout lirik: kiri info dan kontrol, kanan lirik ===== -->
        <Grid Visibility="{Binding ShowLyricsLayout, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Baris atas: sampul 56, judul dan artis, visualizer kecil -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center">
                        <Border CornerRadius="12" Background="{StaticResource CardBrush}">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconMusic}"
                                          Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding MediaArtwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaTitle}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaArtist}" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <components:AudioVisualizer Grid.Column="2" Height="14" VerticalAlignment="Top" Margin="0,4,0,0"
                        BarCount="7" BarWidth="2" BarSpacing="2.5"
                        BarBrush="{Binding MediaAccentBrush}"
                        Level="{Binding AudioMeter.Level}"
                        IsStatic="{Binding AudioMeter.IsUnavailable}" />
                </Grid>

                <!-- Progress, lalu waktu di bawahnya -->
                <components:SeekBar Grid.Row="2" Height="14" VerticalAlignment="Center"
                                    FillBrush="{Binding MediaAccentBrush}"
                                    Value="{Binding MediaProgress, Mode=OneWay}"
                                    IsSeekEnabled="{Binding CanSeek}"
                                    SeekCommand="{Binding SeekCommand}" />
                <Grid Grid.Row="3" Margin="0,1,0,0">
                    <TextBlock Text="{Binding MediaElapsedText}" Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MediaRemainingText}" Style="{StaticResource TextCaption}"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Kontrol -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button Style="{StaticResource MusicTransportButtonStyle}"
                            ToolTip="Previous" AutomationProperties.Name="Previous track"
                            IsEnabled="{Binding CanGoPrevious}"
                            Command="{Binding PreviousTrackCommand}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource MediaIconStyle}" Data="{StaticResource IconPrevious}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource MusicPlayButtonStyle}" Margin="6,0"
                            ToolTip="Play / Pause" AutomationProperties.Name="Play or pause"
                            IsEnabled="{Binding CanPlayPause}"
                            Command="{Binding TogglePlayPauseCommand}">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource MediaPlayPauseIconStyle}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource MusicTransportButtonStyle}"
                            ToolTip="Next" AutomationProperties.Name="Next track"
                            IsEnabled="{Binding CanGoNext}"
                            Command="{Binding NextTrackCommand}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource MediaIconStyle}" Data="{StaticResource IconNext}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Stepper timing dan tombol Lyrics (menyala putih saat panel terbuka; tekan untuk menutup) -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Border Height="28" CornerRadius="14" Background="{StaticResource CardBrush}" Padding="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource StepperButtonStyle}" Content="−"
                                    ToolTip="Show lyrics later" AutomationProperties.Name="Lyrics later"
                                    Command="{Binding Lyrics.OffsetDownCommand}" />
                            <TextBlock Text="{Binding Lyrics.OffsetText}" MinWidth="36" TextAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource StepperButtonStyle}" Content="+"
                                    ToolTip="Show lyrics earlier" AutomationProperties.Name="Lyrics earlier"
                                    Command="{Binding Lyrics.OffsetUpCommand}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource LyricsPillButtonStyle}" Margin="8,0,0,0"
                            ToolTip="Lyrics" AutomationProperties.Name="Lyrics"
                            Command="{Binding Lyrics.ToggleCommand}" />
                </StackPanel>
            </Grid>

            <!-- Kanan: panel lirik. DataContext-nya LyricsViewModel. -->
            <components:LyricsPanel Grid.Column="1" Margin="20,0,0,0" DataContext="{Binding Lyrics}" />
        </Grid>

        <!-- ===== Konfirmasi menyalakan lirik. Menutupi isi tab sampai dipilih. ===== -->
        <Border Background="{StaticResource IslandBrush}"
                Visibility="{Binding ShowLyricsConfirm, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <TextBlock Text="Turn on lyrics?" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Song title, artist and album are sent to lrclib.net to find the lyrics. Nothing else is sent."
                           Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Style="{StaticResource TextCaption}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="Cancel" Style="{StaticResource ChipButtonStyle}"
                            Command="{Binding Lyrics.CancelConfirmCommand}" />
                    <Button Content="Turn on" Margin="8,0,0,0" Style="{StaticResource PrimaryChipButtonStyle}"
                            Command="{Binding Lyrics.ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
