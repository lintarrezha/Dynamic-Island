<UserControl x:Class="iLand.Views.Components.ControlSliderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">

    <!--
        Kartu slider VERTIKAL (volume dan kecerahan), seperti Control Center iPhone: seluruh kartu adalah slider.
        Bagian bawah terisi terang setinggi nilainya, sisanya kaca gelap. Ikon di bawah dan angka kecil di atas
        berganti warna (gelap di atas isi terang, putih di atas kaca). Klik atau geser di mana saja untuk mengatur nilai.
        Lebar dan tinggi kartu ditentukan oleh yang memasang (ControlView.xaml), tidak ada ukuran tetap di sini.
    -->
    <Grid x:Name="Host" Background="Transparent"
          SizeChanged="Host_SizeChanged"
          MouseLeftButtonDown="Host_MouseLeftButtonDown"
          MouseMove="Host_MouseMove"
          MouseLeftButtonUp="Host_MouseLeftButtonUp"
          LostMouseCapture="Host_LostMouseCapture">

        <!-- Latar kaca dan isi terang dipotong bersama menjadi persegi panjang tegak bersudut membulat (ControlTileRadius) -->
        <Grid x:Name="Bars" IsHitTestVisible="False">
            <Border Background="{StaticResource ControlGlassBrush}" />
            <Border x:Name="FillBar" VerticalAlignment="Bottom" Height="0" Background="{StaticResource ControlSliderFillBrush}" />
        </Grid>

        <!-- Batas kaca tipis di atas isi -->
        <Border CornerRadius="{StaticResource ControlTileRadius}" BorderThickness="1" BorderBrush="{StaticResource ControlGlassBorderBrush}"
                IsHitTestVisible="False" />

        <!-- Angka di atas (kecil) -->
        <TextBlock x:Name="ValueText" Text="{Binding Text, ElementName=Root}" Style="{StaticResource TextBodyStrong}"
                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                   IsHitTestVisible="False" />

        <!-- Ikon di bawah -->
        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                 IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <Path x:Name="IconPath" Data="{Binding Icon, ElementName=Root}" StrokeThickness="2"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
