<UserControl x:Class="iLand.Views.Components.ShelfDropZone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False">

    <!--
        Zona drop Shelf yang tampil selama file diseret di atas island (IsActive). Meniru pola referensi:
        - latar hitam polos (Back) menutup isi tab, kotak putus-putus putih tipis, ikon nampan, dan teks "Release to add"
        - cahaya biru besar dari bawah (Glow) yang bernapas sangat pelan
        - saat drop (DropPulse bertambah atau IsActive turun): Back dan isi memudar cepat sehingga tile baru terlihat,
          sedangkan Glow memudar lebih lambat dan tertinggal sebentar
        Semua gerak dijalankan dari ShelfDropZone.xaml.cs. Tanpa timer, tidak ada animasi berulang di luar IsActive.
        Tidak menerima klik.
    -->
    <Grid ClipToBounds="True">

        <Rectangle x:Name="Back" RadiusX="14" RadiusY="14" Fill="{StaticResource IslandBrush}" Opacity="0" />

        <!-- Cahaya biru dari bawah. Warna dan gradiennya dibuat di code-behind dari AccentBrush. -->
        <Ellipse x:Name="Glow" Height="170" VerticalAlignment="Bottom" Margin="-30,0,-30,-96" Opacity="0" />

        <Grid x:Name="Zone" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ZoneScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource TextPrimaryBrush}"
                       StrokeThickness="1.2" StrokeDashArray="3 3" Opacity="0.9" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconShelf}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Release to add" Margin="0,8,0,0" HorizontalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Riak air saat drop berhasil: kilau cahaya lembut mengembang dari tengah. Di atas zona, tidak ikut memudar bersamanya. -->
        <Ellipse x:Name="Ripple" Width="180" Height="180" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RippleScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
