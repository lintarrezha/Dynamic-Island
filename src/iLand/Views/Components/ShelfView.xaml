<UserControl x:Class="iLand.Views.Components.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:iLand.Views.Components"
             xmlns:helpers="clr-namespace:iLand.Helpers">

    <!--
        Tab Shelf (tinggi 280). Header: judul + ringkasan di kiri; di kanan "Clear all" dan pilihan File atau Clipboard
        memakai SegmentedControl yang sama seperti di Timer (indikator meluncur). Urutan segmen HARUS sama dengan enum ShelfSection.
        Bagian File: kotak putus-putus saat kosong, tile 86 x 86 yang membungkus; saat file diseret masuk, area berubah ke aksen.
        Seret masuk dan keluar ditangani ShelfView.xaml.cs (handler Tile_...), jangan diubah namanya.
        Animasi: zona drop (ShelfDropZone) selama file diseret; tile baru masuk (skala, geser, fade; dijalankan Tile_Loaded);
        tile yang dihapus keluar (IsLeaving); keadaan kosong memudar masuk dan keluar; tombol hapus tile memudar saat hover.
        Bagian Clipboard ada di ClipboardView.xaml.
    -->
    <UserControl.Resources>

        <!-- Tombol hapus kecil di pojok tile, hanya terlihat saat tile disorot mouse -->
        <Style x:Key="RemoveTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Circle" Width="16" Height="16" Fill="#99000000" />
                            <Path Data="M6.5 6.5 L13.5 13.5 M13.5 6.5 L6.5 13.5"
                                  Stroke="White" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="#CC3A3A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: judul, ringkasan, Clear all, dan pilihan bagian -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Shelf" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding HeaderSummary}" Margin="10,2,0,0" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Clear all" Margin="0,0,10,0" Command="{Binding ClearCurrentCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                                 Duration="{x:Static helpers:MotionTokens.HoverFadeDuration}"
                                                                 FillBehavior="Stop" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <components:SegmentedControl Width="164"
                                             Items="File|Clipboard"
                                             SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- Bagian File: daftar file sementara dan area drop -->
        <Grid x:Name="FileSection" Grid.Row="1" Visibility="{Binding IsFileSection, Converter={StaticResource BoolToVisibility}}">

            <!-- Keadaan kosong: kotak putus-putus sebagai petunjuk area drop. Memudar masuk dan keluar (tidak menerima klik). -->
            <Grid IsHitTestVisible="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                             EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="{x:Static helpers:MotionTokens.HoverFadeDuration}"
                                                             FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource TextTertiaryBrush}" StrokeThickness="1.5"
                           StrokeDashArray="4 4" />
                <components:EmptyState Icon="{StaticResource IconShelf}" Text="Drag files here to keep them temporarily" />
            </Grid>

            <!-- Daftar file: tile 86 x 86 yang membungkus ke baris berikutnya -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Width="86" Height="86" Margin="0,0,8,8" CornerRadius="14"
                                    Background="{StaticResource CardBrush}" Cursor="Hand"
                                    ToolTip="{Binding FullPath}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Loaded="Tile_Loaded"
                                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tile_PreviewMouseMove"
                                    MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                                <!-- Urutan HARUS tetap: anak 0 = skala, anak 1 = geser (dipakai Tile_Loaded). -->
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
                                        <TranslateTransform x:Name="TileShift" X="0" Y="0" />
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <StackPanel Margin="6,9,6,4" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontSize="11"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="30"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Text="Missing" FontSize="10" Foreground="#FF6961"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,7,0,0"
                                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />

                                    <Button x:Name="RemoveButton" Style="{StaticResource RemoveTileButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                            ToolTip="Remove from Shelf"
                                            Command="{Binding RemoveCommand}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Hover: tombol hapus memudar masuk dan keluar (bukan muncul mendadak). -->
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RemoveButton" Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="{x:Static helpers:MotionTokens.HoverFadeDuration}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RemoveButton" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="{x:Static helpers:MotionTokens.HoverFadeDuration}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                    <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
                                </DataTrigger>

                                <!-- Tile baru: tersembunyi sampai Tile_Loaded memutar animasi masuk. -->
                                <DataTrigger Binding="{Binding IsEntering}" Value="True">
                                    <Setter TargetName="Tile" Property="Opacity" Value="0" />
                                </DataTrigger>

                                <!-- Tile dihapus: mengecil sedikit sambil memudar, lalu dihapus dari daftar oleh ShelfViewModel. -->
                                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="0.85"
                                                                 Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentOutEase}" />
                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="0.85"
                                                                 Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentOutEase}" />
                                                <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentOutEase}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Zona drop saat file diseret di atas island: kotak putus-putus, cahaya biru, ikon nampan. Riak saat drop berhasil. -->
            <components:ShelfDropZone IsActive="{Binding IsDragOver}" DropPulse="{Binding DropCounter}" />
        </Grid>

        <!-- Bagian Clipboard: riwayat teks yang disalin. DataContext-nya ClipboardViewModel -->
        <Grid Grid.Row="1" Visibility="{Binding IsClipboardSection, Converter={StaticResource BoolToVisibility}}">
            <components:ClipboardView DataContext="{Binding Clipboard}" />
        </Grid>
    </Grid>
</UserControl>
