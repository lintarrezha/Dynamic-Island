<UserControl x:Class="iLand.Views.Components.BatteryIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Cincin baterai: lintasan redup + busur berwarna sesuai persen + petir kecil di tengah saat mengisi daya.
        Ukuran semua bagian dihitung di code-behind dari satu property (RingSize), jadi XAML ini tidak berisi angka ukuran.
    -->
    <Grid x:Name="Root">

        <!-- Lintasan: cincin penuh yang redup (isi putih transparan 10%) -->
        <Ellipse x:Name="Track" Fill="Transparent" Stroke="{StaticResource FillStrongBrush}" />

        <!-- Busur isi: bentuknya (Data) dan warnanya diatur code-behind. Canvas membuat koordinat busur absolut. -->
        <Canvas>
            <Path x:Name="Arc"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>

        <!-- Petir: kotak 10 x 10 yang diskalakan Viewbox. Hanya tampil saat baterai sedang diisi. -->
        <Viewbox x:Name="BoltBox" Visibility="Collapsed"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="10" Height="10">
                <Path Data="M5.8 0.5 L1.5 5.6 H4.6 L4.2 9.5 L8.5 4.2 H5.5 Z"
                      Fill="{StaticResource TextPrimaryBrush}" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
