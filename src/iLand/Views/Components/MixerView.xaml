<UserControl x:Class="iLand.Views.Components.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:iLand.Views.Components"
             xmlns:helpers="clr-namespace:iLand.Helpers">

    <!--
        Tab Mixer: baris master di atas (tinggi 46), lalu satu baris per aplikasi yang bersuara (tinggi 44 + jarak 6).
        Daftar aplikasi digulir bila tidak muat; baris master tetap di luar area gulir.
        Baris masuk: tinggi dan fade dari nol. Baris keluar: kebalikannya (IsLeaving), lalu dihapus oleh MixerService.
    -->
    <UserControl.Resources>

        <!-- Tombol mute master: lingkaran 30 px tanpa latar, lingkaran halus saat hover. -->
        <Style x:Key="MixerMuteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="helpers:PressFeedback.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="15" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Angka persen di kanan slider: lebar tetap agar slider tidak bergeser saat angka berubah. -->
        <Style x:Key="MixerValueText" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
            <Setter Property="Width" Value="30" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Satu baris aplikasi. Border luar setinggi 50 (44 isi + 6 jarak atas) yang dianimasikan skala dan opasitasnya. -->
        <DataTemplate x:Key="MixerRowTemplate">
            <Border x:Name="RowRoot" Height="50" Padding="12,6,12,0" Background="Transparent">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="RowScale" ScaleY="1" />
                </Border.LayoutTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Ikon aplikasi, atau speaker kecil bila ikonnya tidak ditemukan -->
                    <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Viewbox Margin="2">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconVolumeOn}"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,8,0"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <components:VolumeSlider Grid.Column="2" Height="20" VerticalAlignment="Center"
                                             AutomationProperties.Name="App volume"
                                             Value="{Binding Volume, Mode=TwoWay}" />

                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Margin="8,0,0,0"
                               Style="{StaticResource MixerValueText}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- Masuk: tinggi dan fade dari nol. Nilai dasar sudah 1, jadi animasi dilepas otomatis setelah selesai. -->
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard FillBehavior="Stop">
                            <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                             From="0" To="1" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                             EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" FillBehavior="Stop" />
                            <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                             EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" FillBehavior="Stop" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <!-- Keluar: kebalikannya. Bila aplikasi bersuara lagi (IsLeaving kembali false), baris muncul lagi. -->
                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                 To="0" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentOutEase}" />
                                <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentOutEase}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="RowRoot" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{x:Static helpers:MotionTokens.RowDuration}"
                                                 EasingFunction="{x:Static helpers:MotionTokens.ContentInEase}" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Baris master -->
        <Border Grid.Row="0" Height="46" CornerRadius="{StaticResource CompactCardRadius}"
                Background="{StaticResource CardBrush}" Padding="8,0,14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource MixerMuteButtonStyle}"
                        ToolTip="Mute" AutomationProperties.Name="Mute master volume"
                        IsEnabled="{Binding IsMasterAvailable}"
                        Command="{Binding ToggleMasterMuteCommand}">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path StrokeThickness="1.8" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconVolumeOn}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMasterSilent}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconVolumeOff}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>

                <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="Master volume" Style="{StaticResource TextCaption}" />
                    <components:VolumeSlider Height="16"
                                             AutomationProperties.Name="Master volume"
                                             IsEnabled="{Binding IsMasterAvailable}"
                                             Value="{Binding MasterVolume, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding MasterPercentText}"
                           Style="{StaticResource MixerValueText}" />
            </Grid>
        </Border>

        <!-- Daftar aplikasi (digulir bila tidak muat) dan keadaan kosong -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource MixerRowTemplate}"
                              Focusable="False" />
            </ScrollViewer>

            <components:EmptyState Icon="{StaticResource IconMixer}" Text="No apps are playing sound"
                                   Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
