<UserControl x:Class="iLand.Views.Components.LyricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!--
        Panel lirik di sisi kanan tab Music (mode lebar). DataContext = LyricsViewModel (diatur MusicTabView).
        Satu dari tiga isi terlihat sesuai State:
        1. Teks keadaan di tengah: "Loading lyrics...", "No lyrics found", "Instrumental", "Couldn't load lyrics".
        2. Lirik tersinkron: daftar baris yang bergulir halus ke baris aktif (gulir dikendalikan LyricsPanel.xaml.cs).
           Baris aktif putih penuh, baris di sebelahnya 60 persen, sisanya 35 persen. Klik baris = loncat ke waktunya.
        3. Lirik biasa (tanpa waktu): teks statis yang bisa digulir dengan roda mouse, dengan catatan "not synced".
        Tepi atas dan bawah memudar lewat transparansi baris itu sendiri (baris yang jauh dari baris aktif makin redup,
        lihat LyricsViewModel.OpacityFor), BUKAN lewat persegi gradien hitam atau OpacityMask. Persegi hitam tampak sebagai
        bercak hitam di atas latar yang berwarna (cahaya sampul), dan OpacityMask membuat animasi buka tutup island patah-patah.
    -->
    <UserControl.Resources>
        <!-- Satu baris lirik: tanpa latar, kursor tangan hanya jika pemutar mengizinkan seek. -->
        <Style x:Key="LyricLineButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CanSeek, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- Saat island menutup, panel diciutkan seketika agar daftar lirik tidak dihitung ulang tiap frame animasi. -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsContextVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- 1. Teks keadaan -->
        <TextBlock Text="{Binding StatusText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                   Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}" />

        <!-- 2. Lirik tersinkron -->
        <ScrollViewer x:Name="SyncedScroller"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Focusable="False"
                      Visibility="{Binding ShowSynced, Converter={StaticResource BoolToVisibility}}"
                      PreviewMouseWheel="SyncedScroller_PreviewMouseWheel"
                      SizeChanged="SyncedScroller_SizeChanged"
                      IsVisibleChanged="SyncedScroller_IsVisibleChanged">
            <!-- Padding atas dan bawah memberi ruang agar baris pertama dan terakhir bisa berada di tengah. -->
            <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" Padding="0,56">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LyricLineButtonStyle}"
                                Opacity="{Binding Opacity}"
                                Command="{Binding DataContext.SeekToLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. Lirik biasa -->
        <Grid Visibility="{Binding ShowPlain, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Lyrics are not synced" Margin="0,2,0,6"
                       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False">
                <TextBlock Text="{Binding PlainText}" TextWrapping="Wrap" Margin="0,0,0,24"
                           Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.85"
                           FontSize="15" LineHeight="22" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
