<Window x:Class="iLand.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:iLand.ViewModels"
        xmlns:sc="clr-namespace:iLand.Views.SettingsControls"
        xmlns:pages="clr-namespace:iLand.Views.SettingsPages"
        Title="iLand Settings"
        Width="860" Height="620"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsWindowBrush}">

    <!--
        Jendela Settings: menu samping (220 px) dan area halaman. Bingkai dan title bar asli Windows yang digelapkan.
        Kamus gaya SettingsTheme.xaml dimuat di sini saja (bukan di App.xaml).
        Halaman dipilih lewat DataTemplate: tipe ViewModel halaman menentukan tampilannya. Halaman dibuat saat dibuka.
        Teks UI dalam bahasa Inggris, komentar dalam bahasa Indonesia.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:IslandSettingsViewModel}">
                <pages:IslandPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MusicSettingsViewModel}">
                <pages:MusicPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CaptureSettingsViewModel}">
                <pages:CapturePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
                <pages:GeneralPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <pages:AboutPage />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Menu samping ===== -->
        <StackPanel Grid.Column="0" Margin="12,22,12,0">
            <TextBlock Text="iLand" Margin="14,2,0,22" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <Grid>
                <!-- Pil putih yang meluncur ke item terpilih (digerakkan SettingsWindow.xaml.cs). Tingginya sama dengan item (36). -->
                <Border x:Name="NavIndicator" Height="36" CornerRadius="18" VerticalAlignment="Top"
                        Background="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorShift" Y="0" />
                    </Border.RenderTransform>
                </Border>

                <ListBox x:Name="Nav"
                         Style="{StaticResource SettingsNavListStyle}"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         AutomationProperties.Name="Settings pages"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionChanged="Nav_SelectionChanged" />
            </Grid>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource SettingsDividerBrush}" />

        <!-- ===== Halaman ===== -->
        <sc:PageHost Grid.Column="2" Page="{Binding CurrentPage}" />
    </Grid>
</Window>
