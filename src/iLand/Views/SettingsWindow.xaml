<Window x:Class="iLand.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:iLand.Converters"
        xmlns:models="clr-namespace:iLand.Models"
        Title="iLand Settings"
        Width="780" Height="560"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
        <conv:EnumVisibilityConverter x:Key="EnumVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar kategori ===== -->
        <StackPanel Grid.Column="0" Margin="14,22,14,14">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="12,0,0,18" />

            <RadioButton Content="General" GroupName="SettingsPages"
                         Style="{StaticResource SidebarItemStyle}"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:SettingsPage.General}}" />
            <RadioButton Content="Appearance" GroupName="SettingsPages"
                         Style="{StaticResource SidebarItemStyle}"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:SettingsPage.Appearance}}" />
            <RadioButton Content="Behavior" GroupName="SettingsPages"
                         Style="{StaticResource SidebarItemStyle}"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:SettingsPage.Behavior}}" />
            <RadioButton Content="Capture" GroupName="SettingsPages"
                         Style="{StaticResource SidebarItemStyle}"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:SettingsPage.Capture}}" />
            <RadioButton Content="About" GroupName="SettingsPages"
                         Style="{StaticResource SidebarItemStyle}"
                         IsChecked="{Binding SelectedPage, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static models:SettingsPage.About}}" />
        </StackPanel>

        <!-- Garis pemisah sidebar dan isi -->
        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <!-- ===== Isi halaman ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <!-- ScrollBar tipis dan gelap hanya untuk area isi ini -->
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBarStyle}" />
            </ScrollViewer.Resources>

            <Grid Margin="32,26,32,30">

                <!-- ################ General ################ -->
                <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EnumVisibility}, ConverterParameter={x:Static models:SettingsPage.General}}">
                    <TextBlock Text="General" Style="{StaticResource PageTitleText}" />

                    <TextBlock Text="STARTUP" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="Open iLand automatically when you sign in. No administrator rights needed."
                                           Style="{StaticResource RowDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding StartWithWindows}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="DISPLAY" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Display on" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="Which monitor shows the island."
                                           Style="{StaticResource RowDescriptionText}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="240"
                                      Style="{StaticResource SettingsComboBoxStyle}"
                                      ItemsSource="{Binding MonitorOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="DeviceName"
                                      SelectedValue="{Binding SelectedMonitorDevice}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ################ Appearance ################ -->
                <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EnumVisibility}, ConverterParameter={x:Static models:SettingsPage.Appearance}}">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitleText}" />

                    <TextBlock Text="EXPANDED ISLAND" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <StackPanel Margin="16,12">
                                <Grid>
                                    <TextBlock Text="Width" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="{Binding ExpandedWidth, StringFormat='{}{0:0} px'}" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider Style="{StaticResource SettingsSliderStyle}" Margin="0,8,0,0"
                                        Minimum="480" Maximum="640" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding ExpandedWidth}" />
                            </StackPanel>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <StackPanel Margin="16,12">
                                <Grid>
                                    <TextBlock Text="Corner radius" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="{Binding ExpandedCornerRadius, StringFormat='{}{0:0} px'}" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider Style="{StaticResource SettingsSliderStyle}" Margin="0,8,0,0"
                                        Minimum="16" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding ExpandedCornerRadius}" />
                            </StackPanel>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <StackPanel Margin="16,12">
                                <Grid>
                                    <TextBlock Text="Opacity" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider Style="{StaticResource SettingsSliderStyle}" Margin="0,8,0,0"
                                        Minimum="0.6" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        Value="{Binding Opacity}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MOTION" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Margin="16,12">
                            <Grid>
                                <TextBlock Text="Animation duration" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="{Binding AnimationDurationMs, StringFormat='{}{0:0} ms'}" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Slider Style="{StaticResource SettingsSliderStyle}" Margin="0,8,0,0"
                                    Minimum="150" Maximum="800" TickFrequency="50" IsSnapToTickEnabled="True"
                                    Value="{Binding AnimationDurationMs}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ################ Behavior ################ -->
                <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EnumVisibility}, ConverterParameter={x:Static models:SettingsPage.Behavior}}">
                    <TextBlock Text="Behavior" Style="{StaticResource PageTitleText}" />

                    <TextBlock Text="EXPANDING" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Hover to expand" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Open the island when the pointer rests on it."
                                               Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HoverToExpand}" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Auto collapse" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Close the island when the pointer leaves it."
                                               Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutoCollapse}" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <StackPanel Margin="16,12">
                                <Grid>
                                    <TextBlock Text="Collapse delay" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="{Binding CollapseDelayMs, StringFormat='{}{0:0} ms'}" Style="{StaticResource ValueText}" />
                                </Grid>
                                <Slider Style="{StaticResource SettingsSliderStyle}" Margin="0,8,0,0"
                                        Minimum="100" Maximum="2000" TickFrequency="100" IsSnapToTickEnabled="True"
                                        Value="{Binding CollapseDelayMs}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AUTOMATIC" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Auto-minimize when content is below" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Shrink into a small notch when the island would cover tabs or text."
                                               Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutoMinimizeWhenWindowBelow}" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Hide when a fullscreen app is active" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Keep out of the way of games and fullscreen video."
                                               Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HideWhenFullscreen}" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Hide island from screenshots" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Keeps the island out of screenshots, recordings and screen sharing. Turning this off also turns off smart collapse."
                                               TextWrapping="Wrap" Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding HideFromScreenshots}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NOTIFICATIONS" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Play sound for notifications" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="Use the Windows notification sound when the island shows an alert."
                                           Style="{StaticResource RowDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding PlayNotificationSound}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="MUSIC" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Lyrics" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="Show synced lyrics for the song you are playing. When on, the title, artist, album and length of the current song are sent to lrclib.net, and nothing else. Off by default. Found lyrics are cached on this PC."
                                           TextWrapping="Wrap" Style="{StaticResource RowDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding LyricsEnabled}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="SHELF" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Clipboard history" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="Keep your last 20 copied texts in the Shelf tab. They stay in memory only, nothing is saved to disk or sent anywhere. Copies marked private by password managers are skipped. Turning this off clears the list."
                                           Style="{StaticResource RowDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding ClipboardHistoryEnabled}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ################ Capture ################ -->
                <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EnumVisibility}, ConverterParameter={x:Static models:SettingsPage.Capture}}">
                    <TextBlock Text="Capture" Style="{StaticResource PageTitleText}" />

                    <TextBlock Text="SCREEN RECORDING AUDIO" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Record system sound" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Include what plays through your speakers or headphones (all apps)."
                                               Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding RecordSystemAudio}" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Record microphone" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="Off by default. The microphone is opened only while a recording is running."
                                               Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding RecordMicrophone}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource RowDescriptionText}" Margin="6,14,0,0"
                               Text="Screenshots are saved to Pictures\iLand and recordings to Videos\Captures. The audio choices apply to the next recording." />
                </StackPanel>

                <!-- ################ About ################ -->
                <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EnumVisibility}, ConverterParameter={x:Static models:SettingsPage.About}}">
                    <TextBlock Text="About" Style="{StaticResource PageTitleText}" />

                    <TextBlock Text="APP" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="16,12">
                                <TextBlock Text="iLand" Style="{StaticResource RowTitleText}" />
                                <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />

                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Your data" Style="{StaticResource RowTitleText}" />
                                    <TextBlock Text="{Binding DataFolderPath}" Style="{StaticResource RowDescriptionText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open folder"
                                        Style="{StaticResource PillButtonStyle}"
                                        Command="{Binding OpenDataFolderCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PRIVACY" Style="{StaticResource CardHeaderText}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Margin="16,14">
                            <TextBlock Style="{StaticResource RowTitleText}" TextWrapping="Wrap"
                                       Text="iLand keeps everything on this PC and does not collect personal information. It sends nothing over the network unless you turn on lyrics." />
                            <TextBlock Style="{StaticResource RowDescriptionText}" Margin="0,10,0,0"
                                       Text="Smart collapse looks at a small picture of the screen area behind the island. The picture is analysed in memory only and is never saved or sent." />
                            <TextBlock Style="{StaticResource RowDescriptionText}" Margin="0,8,0,0"
                                       Text="Screenshots and recordings are saved only in your own folders. The microphone stays off unless you turn it on." />
                            <TextBlock Style="{StaticResource RowDescriptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Lyrics are off by default. When you turn them on, the title, artist, album and length of the song you are playing are sent to lrclib.net to find its lyrics. Lyrics are provided by LRCLIB (lrclib.net)." />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
